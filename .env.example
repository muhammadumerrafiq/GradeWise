# ============================================================
# GRADEWISE — Root Environment Variables Example
# ============================================================

# Backend Settings (see backend/.env.example for full details)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=4096

DATABASE_URL=sqlite+aiosqlite:///./gradewise.db
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=10
MAX_ZIP_SIZE_MB=200
MAX_CONCURRENT_EVALUATIONS=3
SECRET_KEY=change_this_to_a_long_random_string_before_production
ALLOWED_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Frontend Settings (see frontend/.env.example)
VITE_API_URL=http://localhost:8000
