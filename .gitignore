# ============================================================
# GRADEWISE — .gitignore
# ============================================================

# Environment variables — NEVER COMMIT
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases & cache
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
gradewise.db
backend/gradewise.db

# User uploads & generated exports — NEVER COMMIT
uploads/
exports/
backend/uploads/
backend/exports/
sample_submissions/uploads/
**/uploads/*
!**/uploads/.gitkeep
**/exports/*
!**/exports/.gitkeep

# Node / Frontend
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.settings/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Docker
postgres_data/
