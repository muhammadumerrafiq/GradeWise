# ============================================================
# GRADEWISE BACKEND — Environment Variables
# Copy to .env for local development.
# Set these in Railway dashboard for production.
# NEVER commit .env to Git.
# ============================================================

# Gemini API — REQUIRED
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=4096

# Database
# Local:      sqlite+aiosqlite:///./gradewise.db
# Production: Automatically set by Railway PostgreSQL service
DATABASE_URL=sqlite+aiosqlite:///./gradewise.db

# File Storage
# Local:      ./uploads and ./exports
# Production: /data/uploads and /data/exports (Railway Volume)
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# File Limits
MAX_UPLOAD_SIZE_MB=10
MAX_ZIP_SIZE_MB=200

# Processing
MAX_CONCURRENT_EVALUATIONS=3

# Security
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string_in_production

# CORS — comma-separated list of allowed origins
# Local:      http://localhost:5173
# Production: https://your-frontend.up.railway.app (set after deploy)
ALLOWED_ORIGINS=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
