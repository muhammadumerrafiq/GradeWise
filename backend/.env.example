# ============================================================
# GRADEWISE — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Gemini API ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./gradewise.db

# --- File Storage ---
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# --- File Limits ---
MAX_UPLOAD_SIZE_MB=10
MAX_ZIP_SIZE_MB=200

# --- Processing ---
# Max concurrent Gemini API calls (keep <= 5 to avoid rate limits)
MAX_CONCURRENT_EVALUATIONS=3

# --- Security ---
SECRET_KEY=change_this_to_a_long_random_string_before_production

# --- Server ---
ALLOWED_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=8000
DEBUG=true
